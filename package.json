{
  "name": "filebuddy",
  "version": "0.3.2",
  "description": "文小哥 FileBuddy - 把本地文件夹直接交给 AI",
  "author": "FileBuddy Team",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win nsis portable --publish never",
    "build:linux": "electron-builder --linux AppImage --publish never",
    "build:mac": "electron-builder --mac dmg --publish never",
    "build:mac:x64": "electron-builder --mac dmg --x64 --publish never",
    "build:mac:arm64": "electron-builder --mac dmg --arm64 --publish never"
  },
  "build": {
    "appId": "cn.filebuddy.desktop",
    "productName": "文小哥 FileBuddy",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json",
      "assets/**/*"
    ],
    "icon": "assets/filebuddy-icon.png",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "FileBuddy-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "devDependencies": {
    "electron": "^36.3.1",
    "electron-builder": "^26.0.12"
  },
  "allowScripts": {
    "electron@36.9.5": true,
    "electron-winstaller@5.4.0": true
  }
}
